# ============================================================
# Metaworld Web Teleoperation Dockerfile
# Headless server with offscreen MuJoCo rendering (EGL)
# Access via browser at http://server_ip:9527
# ============================================================

FROM nvidia/cuda:11.8.0-cudnn8-devel-ubuntu22.04

ENV DEBIAN_FRONTEND=noninteractive
ENV PYTHONUNBUFFERED=1

# ---- System dependencies (headless rendering) ----
RUN apt-get update && apt-get install -y --no-install-recommends \
        python3.8 \
        python3.8-dev \
        python3.8-distutils \
        python3-pip \
        git \
        wget \
        curl \
        build-essential \
        cmake \
        # MuJoCo offscreen rendering (EGL / osmesa)
        libgl1-mesa-glx \
        libgl1-mesa-dev \
        libegl1-mesa-dev \
        libglib2.0-0 \
        libsm6 \
        libxext6 \
        libxrender-dev \
        libglfw3 \
        libglfw3-dev \
        libglew-dev \
        libosmesa6-dev \
        patchelf \
    && rm -rf /var/lib/apt/lists/*

# Set python3.8 as default
RUN update-alternatives --install /usr/bin/python python /usr/bin/python3.8 1 && \
    update-alternatives --install /usr/bin/python3 python3 /usr/bin/python3.8 1 && \
    python -m pip install --no-cache-dir --upgrade pip setuptools wheel

# ---- Python dependencies ----
WORKDIR /tmp

# Install PyTorch with CUDA 11.8
RUN pip install --no-cache-dir \
    torch==2.0.1+cu118 \
    torchvision \
    torchaudio \
    --index-url https://download.pytorch.org/whl/cu118

# Install Metaworld + web teleop deps
RUN pip install --no-cache-dir \
    metaworld \
    gymnasium \
    pynput \
    zarr==2.12.0 \
    numpy \
    h5py \
    Pillow \
    fastapi \
    "uvicorn[standard]" \
    websockets \
    imageio \
    imageio-ffmpeg \
    matplotlib \
    hydra-core==1.2.0 \
    termcolor \
    opencv-python==4.8.1.78

# ---- Project setup ----
WORKDIR /workspace/DemoGen
COPY . .

ENV HYDRA_FULL_ERROR=1
ENV PYTHONPATH=/workspace/DemoGen
# Offscreen rendering via EGL (GPU-accelerated, headless)
ENV MUJOCO_GL=egl

EXPOSE 9527

CMD ["python", "-m", "metaworld_teleop.teleop_server", "--port", "9527"]
